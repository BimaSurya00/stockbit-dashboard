# Container port (app listen di port ini)
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/stockbit_dashboard

# Copy dari browser network tab setelah login ke stockbit.com
# Lihat di Network > Request Headers > authorization (Bearer token)
STOCKBIT_TOKEN=your_jwt_bearer_token_here
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36

# Provider LLM: 'gemini' (default) atau 'opencode'
LLM_PROVIDER=gemini

# Google Gemini AI (jika LLM_PROVIDER=gemini)
# Daftar gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenCode Go Inference (jika LLM_PROVIDER=opencode)
OPENCODE_GO_API_KEY=sk-...
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=kimi-k2.6
